{
  "name": "lumefood-e2e-tests",
  "version": "1.0.0",
  "description": "Testes end-to-end para o LumeFood com Playwright.",
  "scripts": {
    "browsers:install": "set PLAYWRIGHT_BROWSERS_PATH=.\\work\\ms-playwright&& playwright install chromium",
    "test": "set PLAYWRIGHT_BROWSERS_PATH=.\\work\\ms-playwright&& playwright test",
    "test:headed": "set PLAYWRIGHT_BROWSERS_PATH=.\\work\\ms-playwright&& playwright test --headed",
    "test:ui": "set PLAYWRIGHT_BROWSERS_PATH=.\\work\\ms-playwright&& playwright test --ui",
    "report": "set PLAYWRIGHT_BROWSERS_PATH=.\\work\\ms-playwright&& playwright show-report"
  },
  "keywords": [
    "playwright",
    "e2e",
    "qa",
    "portfolio"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
